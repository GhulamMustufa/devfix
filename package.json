{
  "name": "devfix",
  "version": "1.1.0",
  "description": "An autonomous AI agent for recovering broken developer environments.",
  "type": "module",
  "bin": {
    "devfix": "./bin/devfix"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/adversarial.test.js tests/agent.test.js tests/cancellation.test.js tests/cli.test.js tests/multi-verifier.test.js tests/project-detector.test.js tests/provider.test.js tests/security.test.js tests/state-change.test.js tests/ux-telemetry.test.js tests/verifier-redaction.test.js tests/workspace.test.js",
    "test:docker": "node --test tests/foundation.test.js tests/verifier.test.js",
    "test:e2e": "node --test tests/e2e-acceptance.test.js",
    "validate:release": "node scripts/validate-release.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "[ -d .git ] && husky || true"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "developer-tools",
    "hackathon",
    "devfix",
    "auto-fix"
  ],
  "author": "Ghulam Mustafa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhulamMustufa/devfix.git"
  },
  "bugs": {
    "url": "https://github.com/GhulamMustufa/devfix/issues"
  },
  "homepage": "https://devfix.ghulam-mustafa.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "vitepress": "^1.6.4"
  }
}
